# Copy to .env.local for `npm run dev` (git-ignored).
# Where the dev server sends /api/* (the local patient360-api).
API_ORIGIN=http://localhost:3002
# The S3 origin of the documents bucket that the API's short-lived links point at, allowed by the CSP for the
# document viewer: https://<S3_DOCUMENTS_BUCKET>.s3.<AWS_REGION>.amazonaws.com
DOCUMENTS_ORIGIN=
