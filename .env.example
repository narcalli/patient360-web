# Copy to .env.local for `npm run dev` (git-ignored).
# Where the dev server sends /api/* (the local patient360-api, on its own port).
API_ORIGIN=http://localhost:3000
# The S3 origin of the documents bucket that the API's short-lived links point at, allowed by the CSP for the
# document viewer: https://<S3_DOCUMENTS_BUCKET>.s3.<AWS_REGION>.amazonaws.com
DOCUMENTS_ORIGIN=
# The S3 origin of the lab reports bucket: lab partners upload there and the viewer opens those reports from there.
# https://<S3_REPORTS_BUCKET>.s3.<AWS_REGION>.amazonaws.com
REPORTS_ORIGIN=
# Optional, comma-separated: extra hosts allowed to open the dev server, such as a tunnel (*.ngrok-free.app).
DEV_ALLOWED_ORIGINS=
