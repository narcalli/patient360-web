{
  "name": "patient360-web",
  "version": "1.0.0",
  "private": true,
  "description": "Patient 360 portal: patient, lab partner and admin views",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node scripts/check-white-label.mjs && next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check:white-label": "node scripts/check-white-label.mjs",
    "check": "tsc --noEmit && node scripts/check-white-label.mjs && node --test test/*.test.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
